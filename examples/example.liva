// Ejemplo básico de Liva para probar la extensión

// Función principal
main() {
    // Variables
    let nombre = "Mundo"
    const saludo = "¡Hola"

    // String template
    print($"{saludo} {nombre}!")

    // Arrays
    let numeros = [1, 2, 3, 4, 5]

    // For loop secuencial
    print("\nLoop secuencial:")
    for seq x in numeros {
        print($"Seq: {x}")
    }

    // For loop paralelo
    print("\nLoop paralelo:")
    for par x in numeros {
        print($"Par: {x}")
    }

    // For loop vectorizado
    print("\nLoop vectorizado:")
    for vec x in numeros {
        print($"Vec: {x}")
    }

    // For loop paralelo vectorizado (SIMD)
    print("\nLoop paralelo vectorizado:")
    for parvec x in numeros with simdWidth 4 {
        print($"ParVec: {x}")
    }

    // For loop con opciones
    for par x in numeros with chunk 2 threads 4 {
        print($"Processing {x}")
    }

    print("\n¡Ejemplo completado!")
}

// ============================================================================
// Point-Free Function References (v1.1.0)
// ============================================================================

double(x) => x * 2
isPositive(n) => n > 0

testPointFree() {
    let nums = [1, 2, 3, 4, 5]

    // Point-free: pass function name directly (no lambda needed)
    nums.forEach(print)
    let doubled = nums.map(double)
    let positives = nums.filter(isPositive)
    let strs = nums.map(toString)

    // For loop with point-free
    for n in nums => print
}

// ============================================================================
// Method References with :: (v1.1.0)
// ============================================================================

Formatter {
    prefix: string
    constructor(prefix: string) { this.prefix = prefix }
    format(s: string) => $"{this.prefix}: {s}"
}

testMethodRef() {
    let names = ["Alice", "Bob", "Charlie"]
    let fmt = Formatter("Hello")

    // Method reference: bind instance method as callback
    let greetings = names.map(fmt::format)
    greetings.forEach(print)

    // Also works with forEach, filter, find, some, every
    let logger = Formatter("LOG")
    names.forEach(logger::format)
}

// Función de utilidad
saludar(nombre: string) => $"¡Hola, {nombre}!"

// ============================================================================
// CLASES
// ============================================================================

// Basic class
Person {
    constructor(nombre: string, edad: int) {
        this.nombre = nombre
        this.edad = edad
    }

    nombre: string
    edad: int

    // Methods
    greet() => $"¡Hola!"
    introduce() => $"Soy {this.nombre} y tengo {this.edad} años"
    esAdulto() => this.edad >= 18
}

// Class with private fields
BankAccount {
    constructor(balance: number) {
        this.__balance = balance
    }
    
    __balance: number  // Private
    
    deposit(amount: number) {
        this.__balance = this.__balance + amount
    }
    
    getBalance() => this.__balance
}

