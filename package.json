{
  "name": "liva-vscode",
  "displayName": "Liva Language Support",
  "description": "Complete programming language support for Liva in Visual Studio Code and Cursor. Features syntax highlighting, snippets, compiler integration, union types, type aliases, pattern matching with type narrowing, destructuring, generics, modules, point-free function references, :: method references, and standard library.",
  "version": "0.16.0",
  "publisher": "liva-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/liva-lang/livac.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "liva",
    "programming-language",
    "rust",
    "compiler",
    "destructuring",
    "pattern-matching",
    "generics",
    "trait-aliases",
    "modules",
    "imports",
    "standard-library",
    "arrays",
    "strings",
    "math",
    "async",
    "parallel",
    "http",
    "rest-api",
    "web",
    "point-free",
    "method-reference",
    "callbacks"
  ],
  "contributes": {
    "languages": [
      {
        "id": "liva",
        "aliases": [
          "Liva",
          "liva"
        ],
        "extensions": [
          ".liva"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "liva",
        "scopeName": "source.liva",
        "path": "./syntaxes/liva.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "liva",
        "path": "./snippets/liva.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Liva",
      "properties": {
        "liva.compiler.path": {
          "type": "string",
          "default": "livac",
          "description": "Path to the Liva compiler executable"
        },
        "liva.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Language Server Protocol for advanced features (completion, diagnostics, hover, navigation)"
        },
        "liva.compiler.outputDirectory": {
          "type": "string",
          "default": "./target/liva_build",
          "description": "Default output directory for compiled binaries"
        },
        "liva.compiler.autoBuild": {
          "type": "boolean",
          "default": true,
          "description": "Automatically build on save"
        },
        "liva.liveValidation": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time validation while typing (shows errors as you code)"
        }
      }
    },
    "commands": [
      {
        "command": "liva.compile",
        "title": "Compile Liva File"
      },
      {
        "command": "liva.run",
        "title": "Run Liva Program"
      },
      {
        "command": "liva.check",
        "title": "Check Liva Syntax"
      },
      {
        "command": "liva.format",
        "title": "Format Liva File"
      },
      {
        "command": "liva.lint",
        "title": "Lint Liva File"
      },
      {
        "command": "liva.test",
        "title": "Liva: Run Tests"
      },
      {
        "command": "liva.testCoverage",
        "title": "Liva: Run Tests with Coverage"
      },
      {
        "command": "liva.bench",
        "title": "Liva: Run Benchmarks"
      },
      {
        "command": "liva.doc",
        "title": "Liva: Generate Documentation"
      },
      {
        "command": "liva.repl",
        "title": "Liva: Start REPL"
      },
      {
        "command": "liva.restartLsp",
        "title": "Restart Liva Language Server"
      },
      {
        "command": "liva.updateCompiler",
        "title": "Liva: Update Compiler"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .liva",
          "command": "liva.compile",
          "group": "liva"
        },
        {
          "when": "resourceExtname == .liva",
          "command": "liva.run",
          "group": "liva"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .liva",
          "command": "liva.compile",
          "group": "liva"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:liva"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@vscode/vsce": "^2.22.0",
    "vscode-languageclient": "^9.0.1"
  }
}
